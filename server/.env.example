PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/noxira_certificates
JWT_SECRET=replace_with_min_32_char_cryptographically_secure_secret
INITIAL_ADMIN_PASSWORD=change_this_for_dev_deployments
# Active cohort batch identifier for public website application intake.
# The owner must choose a real batch before website intake can accept applications.
WEBSITE_INTAKE_BATCH_ID=
API_BASE_URL=http://localhost:5173
VERIFY_BASE_URL=http://localhost:5173
STORAGE_DIR=./storage/certificates
CORS_ORIGIN=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
# Configured sender address for outbound emails (e.g. admissions@yourdomain.com)
SMTP_FROM=

# --- Skill courses ---
# TEST ONLY: enables the answer-key endpoint used by end-to-end tests.
# Never set in production; the endpoint also hard-refuses when NODE_ENV=production.
# ALLOW_TEST_HOOKS=true

# LAUNCH GATE: automatic skill-certificate issuance on a passing test.
# Off by default; in production certificates are not auto-issued until the owner
# decides the release/pricing policy and sets this to true.
# SKILL_CERT_AUTO_ISSUE=true
